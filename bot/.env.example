# Скопируй в bot/.env и заполни. .env в git не коммитим.
BOT_TOKEN=
# root-админы (Telegram ID через запятую). Свой ID — команда /myid в боте.
ADMIN_IDS=6163072393
WEBAPP_PORT=9542
# https-адрес мини-аппа (туннель/VPS) — без него в боте не будет кнопки «Открыть мини-апп»
WEBAPP_PUBLIC_URL=

# OCR-каскад — только бесплатные провайдеры, пустой ключ = провайдер пропускается.
# Достаточно одного ключа; лучше 2–3, чтобы при лимите работал следующий.
# Gemini: ключ на aistudio.google.com. Бесплатно, пока к проекту НЕ привязан биллинг.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# OpenRouter: openrouter.ai/keys, используются только «:free»-модели (≈50 запросов/день без пополнения)
OPENROUTER_API_KEY=
# свои free VL-модели через запятую (пусто = список по умолчанию; без «:free» — игнорируются)
OPENROUTER_MODELS=
# NVIDIA NIM: build.nvidia.com → Get API Key (free endpoint для разработчиков)
NIM_API_KEY=
# OCR.space: ocr.space/ocrapi (free — 500 запросов/день; только счёт, без бомбардиров)
OCRSPACE_API_KEY=
# локальная модель через Ollama: `ollama pull qwen2.5vl:3b` (~3.2 ГБ), OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5vl:3b
# 1 = локальная модель раньше облачных
OLLAMA_FIRST=0
